[
  {
    "label": "Configure [debug]",
    "command": "cmake --preset debug",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Build [debug]",
    "command": "cmake --build --preset debug",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Build (verbose) [debug]",
    "command": "cmake --build --preset debug --verbose",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Clean [debug]",
    "command": "cmake --build --preset debug --target clean",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "on_success"
  },
